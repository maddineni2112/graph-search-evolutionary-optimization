    "def success_rate(rows):\n",
    "    return sum(str(row[\"success\"]).lower() == \"true\" for row in rows) / len(rows) if rows else 0.0\n",
    "\n",
    "print(\"\\nMeasured summary\")\n",
    "for name in (\"BFS\", \"DFS\", \"IDS\", \"UCS\", \"Greedy\", \"A*\"):\n",
    "    rows = [row for row in search_rows if row[\"algorithm\"] == name]\n",
    "    print(f\"{name:7s} success={success_rate(rows):.3f} mean_cost={mean(rows, 'path_cost', name):.3f} mean_expanded={mean(rows, 'nodes_expanded', name):.1f}\")\n",
    "for initialization in (\"random\", \"astar_seeded\"):\n",
    "    rows = [row for row in ga_rows if row[\"initialization\"] == initialization]\n",
    "    final = [float(row[\"final_fitness\"]) for row in rows]\n",
    "    print(f\"{initialization:12s} success={success_rate(rows):.3f} mean_final_fitness={statistics.mean(final):.3f} std={statistics.stdev(final):.3f}\")\n",
    "print(\"\\nReproducibility: rerun this notebook from the repository root or its src directory.\")\n",
    "print(\"All quantitative artifacts were generated by the cells above; no values were entered manually.\")"
   ]
