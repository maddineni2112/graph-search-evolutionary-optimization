  {
   "cell_type": "markdown",
   "id": "900a5692",
   "metadata": {},
   "source": [
    "## Graph benchmark generation\n",
    "\n",
    "This section defines the deterministic obstacle-grid representation, reachability control, unit-cost mode, and weighted-terrain mode."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "5c086831",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-09T18:25:41.037986Z",
     "iopub.status.busy": "2026-10-09T18:25:41.036628Z",
     "iopub.status.idle": "2026-10-09T18:25:41.071544Z",
     "shell.execute_reply": "2026-10-09T18:25:41.068868Z"
    }
   },
   "outputs": [],
   "source": [
    "Point = tuple[int, int]\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class GridMap:\n",
    "    size: int\n",
    "    obstacles: set[Point]\n",
    "    terrain_costs: dict[Point, int]\n",
    "    seed: int\n",
    "    density: float\n",
    "    generation_attempt: int\n",
    "\n",
    "    @property\n",
    "    def start(self):\n",
    "        return (0, 0)\n",
    "\n",
    "    @property\n",
    "    def goal(self):\n",
    "        return (self.size - 1, self.size - 1)\n",
    "\n",
    "    @property\n",
    "    def weighted(self):\n",
    "        return bool(self.terrain_costs)\n",
    "\n",
    "    def inside(self, point):\n",
    "        return 0 <= point[0] < self.size and 0 <= point[1] < self.size\n",
    "\n",
    "    def free(self, point):\n",
    "        return self.inside(point) and point not in self.obstacles\n",
    "\n",
    "    def neighbors(self, point):\n",
    "        row, col = point\n",
    "        for candidate in ((row - 1, col), (row, col + 1), (row + 1, col), (row, col - 1)):\n",
    "            if self.free(candidate):\n",
    "                yield candidate\n",
    "\n",
    "    def move_cost(self, point):\n",
    "        return self.terrain_costs.get(point, 1)\n",
    "\n",
    "    def path_cost(self, path):\n",
    "        return None if not path else float(sum(self.move_cost(point) for point in path[1:]))\n",
    "\n",
    "    def heuristic(self, point):\n",
    "        minimum = min(self.terrain_costs.values(), default=1)\n",
    "        return float((abs(point[0] - self.goal[0]) + abs(point[1] - self.goal[1])) * minimum)\n",
    "\n",
    "    def metadata(self):\n",
    "        return {\n",
    "            \"size\": self.size,\n",
    "            \"density\": self.density,\n",
    "            \"seed\": self.seed,\n",
    "            \"generation_attempt\": self.generation_attempt,\n",
    "            \"weighted\": self.weighted,\n",
    "            \"start\": list(self.start),\n",
    "            \"goal\": list(self.goal),\n",
    "            \"obstacle_count\": len(self.obstacles),\n",
    "            \"terrain_cost_values\": sorted(set(self.terrain_costs.values())) if self.weighted else [1],\n",
    "        }\n",
    "\n",
    "\n",
    "def reachable(grid):\n",
    "    queue, seen = deque([grid.start]), {grid.start}\n",
    "    while queue:\n",
    "        current = queue.popleft()\n",
    "        if current == grid.goal:\n",
    "            return True\n",
    "        for neighbor in grid.neighbors(current):\n",
    "            if neighbor not in seen:\n",
    "                seen.add(neighbor)\n",
    "                queue.append(neighbor)\n",
    "    return False\n",
    "\n",
    "\n",
    "def generate_grid(size, density, seed, weighted=False):\n",
    "    for attempt in range(250):\n",
    "        rng = random.Random(seed + attempt)\n",
    "        obstacles = set()\n",
    "        for row in range(size):\n",
    "            for col in range(size):\n",
    "                point = (row, col)\n",
    "                if point not in ((0, 0), (size - 1, size - 1)) and rng.random() < density:\n",
    "                    obstacles.add(point)\n",
    "        terrain = {}\n",
    "        if weighted:\n",
    "            for row in range(size):\n",
    "                for col in range(size):\n",
    "                    point = (row, col)\n",
    "                    if point not in obstacles:\n",
    "                        terrain[point] = rng.choice((1, 3, 7))\n",
    "        grid = GridMap(size, obstacles, terrain, seed, density, attempt)\n",
    "        if reachable(grid):\n",
    "            return grid\n",
    "    raise RuntimeError(\"Could not generate a reachable grid\")\n",
    "\n",
    "\n",
    "def reconstruct(parent, start, goal):\n",
    "    if goal != start and goal not in parent:\n",
    "        return None\n",
    "    path = [goal]\n",
    "    while path[-1] != start:\n",
    "        path.append(parent[path[-1]])\n",
    "    return list(reversed(path))\n",
    "\n",
    "\n",
    "@dataclass\n",
    "class SearchResult:\n",
    "    algorithm: str\n",
    "    path: list[Point] | None\n",
    "    nodes_expanded: int\n",
    "    nodes_generated: int\n",
    "    max_frontier: int\n",
    "    runtime_ms: float\n",
    "\n",
    "    @property\n",
    "    def success(self):\n",
    "        return self.path is not None\n",
    "\n",
    "    def record(self, grid, seed=0):\n",
    "        return {\n",
    "            \"graph_id\": f\"g{grid.size}_d{int(grid.density * 100):02d}_{'weighted' if grid.weighted else 'unit'}_{grid.seed}\",\n",
    "            \"grid_size\": grid.size,\n",
    "            \"obstacle_density\": grid.density,\n",
    "            \"weighted\": grid.weighted,\n",
    "            \"algorithm\": self.algorithm,\n",
    "            \"seed\": seed,\n",
    "            \"success\": self.success,\n",
    "            \"path_length\": None if not self.path else len(self.path) - 1,\n",
    "            \"path_cost\": grid.path_cost(self.path),\n",
    "            \"nodes_expanded\": self.nodes_expanded,\n",
    "            \"nodes_generated\": self.nodes_generated,\n",
    "            \"max_frontier\": self.max_frontier,\n",
    "            \"runtime_ms\": self.runtime_ms,\n",
    "        }\n",
    "\n",
    "\n",
    "def finish(grid, name, path, expanded, generated, frontier, started):\n",
    "    return SearchResult(name, path, expanded, generated, frontier, (time.perf_counter() - started) * 1000.0)"
   ]
  },
