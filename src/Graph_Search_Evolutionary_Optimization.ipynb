   "source": [
    "def write_csv(path, rows):\n",
    "    with path.open(\"w\", newline=\"\", encoding=\"utf-8\") as handle:\n",
    "        writer = csv.DictWriter(handle, fieldnames=list(rows[0]))\n",
    "        writer.writeheader(); writer.writerows(rows)\n",
    "\n",
    "\n",
    "def row_for_ga(grid, result):\n",
    "    return {\n",
    "        \"graph_id\": f\"g{grid.size}_d{int(grid.density * 100):02d}_{'weighted' if grid.weighted else 'unit'}_{grid.seed}\",\n",
    "        \"grid_size\": grid.size, \"obstacle_density\": grid.density, \"weighted\": grid.weighted,\n",
    "        \"algorithm\": result[\"algorithm\"], \"seed\": result[\"seed\"], \"initialization\": result[\"initialization\"],\n",
    "        \"success\": result[\"success\"], \"path_length\": result[\"path_length\"], \"path_cost\": result[\"path_cost\"],\n",
    "        \"final_fitness\": result[\"final_fitness\"], \"generations\": result[\"generations\"],\n",
    "        \"fitness_evaluations\": result[\"fitness_evaluations\"], \"runtime_ms\": result[\"runtime_ms\"],\n",
    "        \"astar_seed_runtime_ms\": result[\"astar_seed_runtime_ms\"],\n",
    "    }\n",
    "\n",
    "\n",
    "def scenario_id(grid):\n",
    "    return f\"g{grid.size}_d{int(grid.density * 100):02d}_{'weighted' if grid.weighted else 'unit'}_{grid.seed}\"\n",
    "\n",
    "\n",
    "scenarios = []\n",
    "index = 0\n",
    "for size in GRID_SIZES:\n",
    "    for density in OBSTACLE_DENSITIES:\n",
    "        for weighted in MODES:\n",
    "            scenarios.append(generate_grid(size, density, 7000 + index, weighted)); index += 1\n",
    "\n",
    "search_rows, ga_rows, convergence_rows = [], [], []\n",
    "best_paths = {}\n",
    "for grid in scenarios:\n",
    "    for name, algorithm in SEARCH.items():\n",
    "        result = algorithm(grid); search_rows.append(result.record(grid)); best_paths[(scenario_id(grid), name)] = result.path\n",
    "    for initialization in (\"random\", \"astar_seeded\"):\n",
    "        for seed in GA_SEEDS:\n",
    "            result = genetic_search(grid, seed, initialization=initialization, population_size=GA_CONFIG[\"population_size\"], generations=GA_CONFIG[\"generations\"], elite_count=GA_CONFIG[\"elite_count\"], crossover_probability=GA_CONFIG[\"crossover_probability\"], mutation_probability=GA_CONFIG[\"mutation_probability\"])\n",
    "            ga_rows.append(row_for_ga(grid, result)); best_paths[(scenario_id(grid), result[\"algorithm\"])] = result[\"path\"]\n",
    "            for generation, (best, mean) in enumerate(zip(result[\"best_history\"], result[\"mean_history\"]), start=1):\n",
    "                convergence_rows.append({\"graph_id\": scenario_id(grid), \"grid_size\": grid.size, \"obstacle_density\": grid.density, \"weighted\": grid.weighted, \"initialization\": initialization, \"seed\": seed, \"generation\": generation, \"best_fitness\": best, \"mean_fitness\": mean})\n",
    "\n",
    "write_csv(RESULTS / \"algorithm_comparison.csv\", search_rows)\n",
    "write_csv(RESULTS / \"stochastic_trials.csv\", ga_rows)\n",
    "write_csv(RESULTS / \"convergence.csv\", convergence_rows)\n",
    "manifest = {\n",
    "    \"project\": \"Search-Guided Evolutionary Optimization for Graph Pathfinding\",\n",
    "    \"grid_sizes\": list(GRID_SIZES), \"obstacle_densities\": list(OBSTACLE_DENSITIES),\n",
    "    \"modes\": [\"weighted\" if mode else \"unit\" for mode in MODES], \"ga_seeds\": list(GA_SEEDS),\n",
    "    \"ga_config\": GA_CONFIG, \"scenarios\": [grid.metadata() for grid in scenarios],\n",
    "    \"search_algorithms\": list(SEARCH), \"evolutionary_algorithms\": [\"GA\", \"GA-seeded\"],\n",
    "}\n",
    "(RESULTS / \"experiment_manifest.json\").write_text(json.dumps(manifest, indent=2), encoding=\"utf-8\")\n",
    "print(\"Executed scenarios:\", len(scenarios))\n",
    "print(\"Classical result rows:\", len(search_rows))\n",
    "print(\"Evolutionary trial rows:\", len(ga_rows))\n",
    "print(\"Convergence rows:\", len(convergence_rows))"
   ]
  },
