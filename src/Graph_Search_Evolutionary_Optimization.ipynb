" stroke-width=\"1\"/><line x1=\"56\" y1=\"588\" x2=\"70\" y2=\"588\" stroke=\"#c53030\" stroke-width=\"3\"/><text x=\"74\" y=\"592\" font-family=\"Arial\" font-size=\"10\">BFS</text><line x1=\"151\" y1=\"588\" x2=\"165\" y2=\"588\" stroke=\"#2b6cb0\" stroke-width=\"3\"/><text x=\"169\" y=\"592\" font-family=\"Arial\" font-size=\"10\">UCS</text><line x1=\"246\" y1=\"588\" x2=\"260\" y2=\"588\" stroke=\"#2f855a\" stroke-width=\"3\"/><text x=\"264\" y=\"592\" font-family=\"Arial\" font-size=\"10\">A*</text><line x1=\"341\" y1=\"588\" x2=\"355\" y2=\"588\" stroke=\"#805ad5\" stroke-width=\"3\"/><text x=\"359\" y=\"592\" font-family=\"Arial\" font-size=\"10\">GA</text><line x1=\"436\" y1=\"588\" x2=\"450\" y2=\"588\" stroke=\"#d69e2e\" stroke-width=\"3\"/><text x=\"454\" y=\"592\" font-family=\"Arial\" font-size=\"10\">GA-seeded</text></svg>"
