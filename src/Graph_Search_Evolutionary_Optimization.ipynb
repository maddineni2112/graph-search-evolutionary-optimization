   "source": [
    "def svg_escape(value):\n",
    "    return str(value).replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n",
    "\n",
    "\n",
    "def grid_svg(grid, paths, title):\n",
    "    cell = 12; margin = 56; legend_width = max(0, len(paths) - 1) * 95 + 80; size = max(margin * 2 + grid.size * cell, margin * 2 + legend_width)\n",
    "    parts = [f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{size}\" height=\"{size + 24}\" viewBox=\"0 0 {size} {size + 24}\">', '<rect width=\"100%\" height=\"100%\" fill=\"white\"/>', f'<text x=\"{size/2}\" y=\"18\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"14\" font-weight=\"bold\">{svg_escape(title)}</text>']\n",
    "    for row in range(grid.size):\n",
    "        for col in range(grid.size):\n",
    "            point = (row, col); x = margin + col * cell; y = 28 + row * cell\n",
    "            fill = \"#263238\" if point in grid.obstacles else (\"#d9f0ff\" if grid.weighted and grid.move_cost(point) == 1 else \"#f4e4ba\" if grid.weighted else \"#f7fbff\")\n",
    "            parts.append(f'<rect x=\"{x}\" y=\"{y}\" width=\"{cell-1}\" height=\"{cell-1}\" fill=\"{fill}\"/>')\n",
    "    colors = [\"#c53030\", \"#2b6cb0\", \"#2f855a\", \"#805ad5\", \"#d69e2e\"]\n",
    "    for (name, path), color in zip(paths.items(), colors):\n",
    "        if path:\n",
    "            points = \" \".join(f\"{margin + p[1]*cell + cell/2},{28 + p[0]*cell + cell/2}\" for p in path)\n",
    "            parts.append(f'<polyline points=\"{points}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"2\" opacity=\"0.85\"/>')\n",
    "    for point, color in ((grid.start, \"#276749\"), (grid.goal, \"#9b2c2c\")):\n",
    "        cx, cy = margin + point[1]*cell + cell/2, 28 + point[0]*cell + cell/2\n",
    "        parts.append(f'<circle cx=\"{cx}\" cy=\"{cy}\" r=\"4\" fill=\"{color}\" stroke=\"white\" stroke-width=\"1\"/>')\n",
    "    legend_y = size + 16\n",
    "    for index, name in enumerate(paths):\n",
    "        x = margin + index * 95; parts.append(f'<line x1=\"{x}\" y1=\"{legend_y}\" x2=\"{x+14}\" y2=\"{legend_y}\" stroke=\"{colors[index]}\" stroke-width=\"3\"/><text x=\"{x+18}\" y=\"{legend_y+4}\" font-family=\"Arial\" font-size=\"10\">{svg_escape(name)}</text>')\n",
    "    parts.append(\"</svg>\")\n",
    "    return \"\".join(parts)\n",
    "\n",
    "\n",
    "def bar_svg(labels, values_a, values_b, title, label_a, label_b, y_label):\n",
    "    width, height, left, bottom = 840, 420, 70, 70; maximum = max(values_a + values_b) or 1; plot_h = height - bottom - 45; bar_w = 24; group_w = 92\n",
    "    parts = [f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{width}\" height=\"{height}\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><text x=\"{width/2}\" y=\"24\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"16\" font-weight=\"bold\">{svg_escape(title)}</text>', f'<line x1=\"{left}\" y1=\"{height-bottom}\" x2=\"{width-25}\" y2=\"{height-bottom}\" stroke=\"#333\"/><text x=\"18\" y=\"{height/2}\" transform=\"rotate(-90 18 {height/2})\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"11\">{svg_escape(y_label)}</text>']\n",
    "    for i, label in enumerate(labels):\n",
    "        x = left + 20 + i * group_w; ha = values_a[i] / maximum * plot_h; hb = values_b[i] / maximum * plot_h\n",
    "        parts.append(f'<rect x=\"{x}\" y=\"{height-bottom-ha}\" width=\"{bar_w}\" height=\"{ha}\" fill=\"#2b6cb0\"/><rect x=\"{x+bar_w+4}\" y=\"{height-bottom-hb}\" width=\"{bar_w}\" height=\"{hb}\" fill=\"#c05621\"/><text x=\"{x+bar_w}\" y=\"{height-bottom+18}\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"10\">{svg_escape(label)}</text>')\n",
    "    parts += [f'<rect x=\"{width-190}\" y=\"42\" width=\"12\" height=\"12\" fill=\"#2b6cb0\"/><text x=\"{width-172}\" y=\"52\" font-family=\"Arial\" font-size=\"11\">{svg_escape(label_a)}</text>', f'<rect x=\"{width-190}\" y=\"62\" width=\"12\" height=\"12\" fill=\"#c05621\"/><text x=\"{width-172}\" y=\"72\" font-family=\"Arial\" font-size=\"11\">{svg_escape(label_b)}</text>', \"</svg>\"]\n",
    "    return \"\".join(parts)\n",
    "\n",
    "\n",
    "def mean(rows, field, name):\n",
    "    values = [float(row[field]) for row in rows if row.get(\"algorithm\") == name and row.get(field) not in (None, \"\", \"None\")]\n",
    "    return statistics.mean(values) if values else 0.0\n",
    "\n",
    "\n",
    "representative = next(grid for grid in scenarios if grid.size == 25 and not grid.weighted and abs(grid.density - 0.15) < 1e-9)\n",
    "representative_id = scenario_id(representative)\n",
    "rep_paths = {name: best_paths[(representative_id, name)] for name in (\"BFS\", \"UCS\", \"A*\", \"GA\", \"GA-seeded\")}\n",
    "(FIGURES / \"representative_paths.svg\").write_text(grid_svg(representative, rep_paths, \"Representative paths on a 25 x 25 unit-cost grid\"), encoding=\"utf-8\")\n",
    "unit_rows = [row for row in search_rows if row[\"weighted\"] is False]\n",
    "labels = [\"BFS\", \"DFS\", \"IDS\", \"UCS\", \"Greedy\", \"A*\"]\n",
    "costs = [mean(unit_rows, \"path_cost\", name) for name in labels]\n",
    "expanded = [mean(unit_rows, \"nodes_expanded\", name) for name in labels]\n",
    "(FIGURES / \"classical_search_comparison.svg\").write_text(bar_svg(labels, costs, expanded, \"Classical search on unit-cost maps\", \"Mean path cost\", \"Mean nodes expanded\", \"Measured value\"), encoding=\"utf-8\")\n",
    "\n",
    "convergence_means = {}\n",
    "for initialization in (\"random\", \"astar_seeded\"):\n",
    "    rows = [row for row in convergence_rows if row[\"initialization\"] == initialization and row[\"grid_size\"] == 25 and row[\"weighted\"] is False and abs(float(row[\"obstacle_density\"]) - 0.15) < 1e-9]\n",
    "    for row in rows:\n",
    "        convergence_means.setdefault((initialization, int(row[\"generation\"])), []).append(float(row[\"best_fitness\"]))\n",
    "svg_lines = ['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"840\" height=\"420\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><text x=\"420\" y=\"24\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"16\" font-weight=\"bold\">GA convergence on the representative scenario</text>']\n",
    "for initialization, color in ((\"random\", \"#718096\"), (\"astar_seeded\", \"#2f855a\")):\n",
    "    points = []\n",
    "    for generation in range(1, GA_CONFIG[\"generations\"] + 1):\n",
    "        value = statistics.mean(convergence_means[(initialization, generation)])\n",
    "        x = 60 + (generation - 1) * 760 / (GA_CONFIG[\"generations\"] - 1); y = 360 - min(value, 2000) / 2000 * 290\n",
    "        points.append(f\"{x:.1f},{y:.1f}\")\n",
    "    svg_lines.append(f'<polyline points=\"{\" \".join(points)}\" fill=\"none\" stroke=\"{color}\" stroke-width=\"2\"/>')\n",
    "svg_lines += ['<line x1=\"60\" y1=\"360\" x2=\"820\" y2=\"360\" stroke=\"#333\"/><text x=\"440\" y=\"405\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"11\">Generation</text><text x=\"18\" y=\"210\" transform=\"rotate(-90 18 210)\" text-anchor=\"middle\" font-family=\"Arial\" font-size=\"11\">Best fitness</text><line x1=\"650\" y1=\"50\" x2=\"670\" y2=\"50\" stroke=\"#718096\" stroke-width=\"3\"/><text x=\"678\" y=\"54\" font-family=\"Arial\" font-size=\"11\">Random GA</text><line x1=\"650\" y1=\"72\" x2=\"670\" y2=\"72\" stroke=\"#2f855a\" stroke-width=\"3\"/><text x=\"678\" y=\"76\" font-family=\"Arial\" font-size=\"11\">A*-seeded GA</text></svg>']\n",
    "(FIGURES / \"ga_convergence.svg\").write_text(\"\".join(svg_lines), encoding=\"utf-8\")\n",
    "print(\"Generated figures:\")\n",
    "for figure in sorted(FIGURES.glob(\"*.svg\")):\n",
    "    print(\" -\", figure.relative_to(ROOT))\n",
    "\n",
    "try:\n",
    "    from IPython.display import SVG, display\n",
    "    for figure in sorted(FIGURES.glob(\"*.svg\")):\n",
    "        display(SVG(filename=str(figure)))\n",
    "except ImportError:\n",
    "    pass\n"
   ]
  },
