   "cell_type": "markdown",
   "id": "e5c19846",
   "metadata": {},
   "source": [
    "## Evolutionary and hybrid optimizer\n",
    "\n",
    "The Genetic Algorithm uses fixed-length four-direction chromosomes. The A*-seeded variant is an ablation that changes only the initial population construction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "87bac8c2",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-09T18:25:41.110733Z",
     "iopub.status.busy": "2026-10-09T18:25:41.110733Z",
     "iopub.status.idle": "2026-10-09T18:25:41.172948Z",
     "shell.execute_reply": "2026-10-09T18:25:41.170935Z"
    }
   },
   "outputs": [],
   "source": [
    "ACTIONS = (\"U\", \"R\", \"D\", \"L\")\n",
    "DELTAS = {\"U\": (-1, 0), \"R\": (0, 1), \"D\": (1, 0), \"L\": (0, -1)}\n",
    "\n",
    "\n",
    "def path_to_actions(path):\n",
    "    actions = []\n",
    "    for previous, current in zip(path, path[1:]):\n",
    "        delta = (current[0] - previous[0], current[1] - previous[1])\n",
    "        actions.append(next(name for name, value in DELTAS.items() if value == delta))\n",
    "    return actions\n",
    "\n",
    "\n",
    "def decode(grid, chromosome):\n",
    "    current, path, seen = grid.start, [grid.start], {grid.start}\n",
    "    invalid = revisits = 0\n",
    "    for action in chromosome:\n",
    "        if action not in DELTAS:\n",
    "            invalid += 1; continue\n",
    "        delta = DELTAS[action]; candidate = (current[0] + delta[0], current[1] + delta[1])\n",
    "        if not grid.free(candidate):\n",
    "            invalid += 1; continue\n",
    "        current = candidate; path.append(current)\n",
    "        if current in seen: revisits += 1\n",
    "        seen.add(current)\n",
    "        if current == grid.goal: break\n",
    "    distance = abs(current[0] - grid.goal[0]) + abs(current[1] - grid.goal[1])\n",
    "    return {\"path\": path, \"success\": current == grid.goal, \"invalid\": invalid, \"revisits\": revisits, \"distance\": distance}\n",
    "\n",
    "\n",
    "def fitness(grid, decoded):\n",
    "    travel = grid.path_cost(decoded[\"path\"]) or 0.0\n",
    "    length = len(decoded[\"path\"]) - 1\n",
    "    penalties = 1.5 * decoded[\"invalid\"] + 0.75 * decoded[\"revisits\"]\n",
    "    if decoded[\"success\"]:\n",
    "        return travel + 0.05 * length + penalties\n",
    "    return 1000.0 + 20.0 * decoded[\"distance\"] + travel + penalties\n",
    "\n",
    "\n",
    "def genetic_search(grid, seed, initialization=\"random\", population_size=30, generations=50, elite_count=2, crossover_probability=0.8, mutation_probability=0.05):\n",
    "    started = time.perf_counter(); rng = random.Random(seed); length = 6 * grid.size\n",
    "    astar_seed_ms = 0.0; seed_chromosome = None\n",
    "    if initialization == \"astar_seeded\":\n",
    "        seed_start = time.perf_counter(); seed_result = astar(grid); astar_seed_ms = (time.perf_counter() - seed_start) * 1000.0\n",
    "        if seed_result.path:\n",
    "            seed_chromosome = path_to_actions(seed_result.path)[:length]\n",
    "\n",
    "    def random_chromosome():\n",
    "        return [rng.choice(ACTIONS) for _ in range(length)]\n",
    "\n",
    "    population = [random_chromosome() for _ in range(population_size)]\n",
    "    if seed_chromosome:\n",
    "        padded = seed_chromosome + [rng.choice(ACTIONS) for _ in range(length - len(seed_chromosome))]\n",
    "        population[0] = padded\n",
    "        for index in range(1, min(5, population_size)):\n",
    "            variant = list(padded)\n",
    "            for gene in range(length):\n",
    "                if rng.random() < 0.08: variant[gene] = rng.choice(ACTIONS)\n",
    "            population[index] = variant\n",
    "\n",
    "    evaluations = 0; best_history = []; mean_history = []; best_fitness = math.inf; best_decoded = None\n",
    "    for _ in range(generations):\n",
    "        scored = []\n",
    "        for chromosome in population:\n",
    "            decoded = decode(grid, chromosome); value = fitness(grid, decoded); evaluations += 1\n",
    "            scored.append((value, chromosome, decoded))\n",
    "        scored.sort(key=lambda item: item[0])\n",
    "        if scored[0][0] < best_fitness:\n",
    "            best_fitness, best_decoded = scored[0][0], scored[0][2]\n",
    "        best_history.append(scored[0][0]); mean_history.append(sum(item[0] for item in scored) / len(scored))\n",
    "        next_population = [list(item[1]) for item in scored[:elite_count]]\n",
    "        while len(next_population) < population_size:\n",
    "            sample_a = rng.sample(scored, min(3, len(scored))); sample_b = rng.sample(scored, min(3, len(scored)))\n",
    "            parent_a = list(min(sample_a, key=lambda item: item[0])[1]); parent_b = list(min(sample_b, key=lambda item: item[0])[1])\n",
    "            child_a, child_b = list(parent_a), list(parent_b)\n",
    "            if rng.random() < crossover_probability:\n",
    "                point = rng.randint(1, length - 1); child_a = parent_a[:point] + parent_b[point:]; child_b = parent_b[:point] + parent_a[point:]\n",
    "            for child in (child_a, child_b):\n",
    "                for gene in range(length):\n",
    "                    if rng.random() < mutation_probability: child[gene] = rng.choice(ACTIONS)\n",
    "                next_population.append(child)\n",
    "                if len(next_population) >= population_size: break\n",
    "        population = next_population\n",
    "    return {\n",
    "        \"algorithm\": \"GA-seeded\" if initialization == \"astar_seeded\" else \"GA\",\n",
    "        \"seed\": seed, \"initialization\": initialization,\n",
    "        \"path\": best_decoded[\"path\"] if best_decoded[\"success\"] else None,\n",
    "        \"success\": best_decoded[\"success\"],\n",
    "        \"path_length\": len(best_decoded[\"path\"]) - 1 if best_decoded[\"success\"] else None,\n",
    "        \"path_cost\": grid.path_cost(best_decoded[\"path\"]) if best_decoded[\"success\"] else None,\n",
    "        \"final_fitness\": best_fitness, \"best_history\": best_history, \"mean_history\": mean_history,\n",
    "        \"generations\": generations, \"fitness_evaluations\": evaluations,\n",
    "        \"runtime_ms\": (time.perf_counter() - started) * 1000.0, \"astar_seed_runtime_ms\": astar_seed_ms,\n",
    "    }"
   ]
  },
