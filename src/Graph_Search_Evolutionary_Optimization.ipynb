   "source": [
    "## Classical search implementations\n",
    "\n",
    "All baseline algorithms use a common result schema so path quality and search effort can be compared fairly."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "63f3611f",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-09T18:25:41.076556Z",
     "iopub.status.busy": "2026-10-09T18:25:41.075556Z",
     "iopub.status.idle": "2026-10-09T18:25:41.104970Z",
     "shell.execute_reply": "2026-10-09T18:25:41.103610Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Classical algorithms: BFS, DFS, IDS, UCS, Greedy, A*\n"
     ]
    }
   ],
   "source": [
    "def bfs(grid):\n",
    "    started = time.perf_counter()\n",
    "    queue, parent, discovered = deque([grid.start]), {}, {grid.start}\n",
    "    expanded, maximum = 0, 1\n",
    "    while queue:\n",
    "        current = queue.popleft(); expanded += 1\n",
    "        if current == grid.goal: break\n",
    "        for neighbor in grid.neighbors(current):\n",
    "            if neighbor not in discovered:\n",
    "                discovered.add(neighbor); parent[neighbor] = current; queue.append(neighbor)\n",
    "        maximum = max(maximum, len(queue))\n",
    "    return finish(grid, \"BFS\", reconstruct(parent, grid.start, grid.goal) if grid.goal in discovered else None, expanded, len(discovered), maximum, started)\n",
    "\n",
    "\n",
    "def dfs(grid):\n",
    "    started = time.perf_counter()\n",
    "    stack, parent, discovered = [grid.start], {}, {grid.start}\n",
    "    expanded, maximum = 0, 1\n",
    "    while stack:\n",
    "        current = stack.pop(); expanded += 1\n",
    "        if current == grid.goal: break\n",
    "        for neighbor in reversed(list(grid.neighbors(current))):\n",
    "            if neighbor not in discovered:\n",
    "                discovered.add(neighbor); parent[neighbor] = current; stack.append(neighbor)\n",
    "        maximum = max(maximum, len(stack))\n",
    "    return finish(grid, \"DFS\", reconstruct(parent, grid.start, grid.goal) if grid.goal in discovered else None, expanded, len(discovered), maximum, started)\n",
    "\n",
    "\n",
    "def ids(grid):\n",
    "    started = time.perf_counter(); expanded = generated = maximum = 0\n",
    "    for limit in range(grid.size * grid.size + 1):\n",
    "        stack, depth_seen = [(grid.start, [grid.start])], {grid.start: 0}\n",
    "        maximum = max(maximum, 1)\n",
    "        while stack:\n",
    "            current, path = stack.pop(); expanded += 1\n",
    "            if current == grid.goal:\n",
    "                return finish(grid, \"IDS\", path, expanded, generated, maximum, started)\n",
    "            depth = len(path) - 1\n",
    "            if depth >= limit: continue\n",
    "            for neighbor in reversed(list(grid.neighbors(current))):\n",
    "                generated += 1; next_depth = depth + 1\n",
    "                if next_depth < depth_seen.get(neighbor, grid.size * grid.size + 1):\n",
    "                    depth_seen[neighbor] = next_depth; stack.append((neighbor, path + [neighbor]))\n",
    "            maximum = max(maximum, len(stack))\n",
    "    return finish(grid, \"IDS\", None, expanded, generated, maximum, started)\n",
    "\n",
    "\n",
    "def priority_search(grid, name, score):\n",
    "    started = time.perf_counter(); counter = 0\n",
    "    heap = [(score(grid.start, 0.0), 0.0, counter, grid.start)]\n",
    "    best, parent, expanded, generated, maximum = {grid.start: 0.0}, {}, 0, 1, 1\n",
    "    while heap:\n",
    "        _, current_cost, _, current = heapq.heappop(heap)\n",
    "        if current_cost != best.get(current): continue\n",
    "        expanded += 1\n",
    "        if current == grid.goal: break\n",
    "        for neighbor in grid.neighbors(current):\n",
    "            next_cost = current_cost + grid.move_cost(neighbor)\n",
    "            if next_cost < best.get(neighbor, math.inf):\n",
    "                best[neighbor] = next_cost; parent[neighbor] = current; counter += 1; generated += 1\n",
    "                heapq.heappush(heap, (score(neighbor, next_cost), next_cost, counter, neighbor))\n",
    "        maximum = max(maximum, len(heap))\n",
    "    return finish(grid, name, reconstruct(parent, grid.start, grid.goal) if grid.goal in best else None, expanded, generated, maximum, started)\n",
    "\n",
    "\n",
    "def ucs(grid):\n",
    "    return priority_search(grid, \"UCS\", lambda node, cost: cost)\n",
    "\n",
    "\n",
    "def greedy(grid):\n",
    "    return priority_search(grid, \"Greedy\", lambda node, cost: grid.heuristic(node))\n",
    "\n",
    "\n",
    "def astar(grid):\n",
    "    return priority_search(grid, \"A*\", lambda node, cost: cost + grid.heuristic(node))\n",
    "\n",
    "\n",
    "SEARCH = {\"BFS\": bfs, \"DFS\": dfs, \"IDS\": ids, \"UCS\": ucs, \"Greedy\": greedy, \"A*\": astar}\n",
    "print(\"Classical algorithms:\", \", \".join(SEARCH))"
   ]
  },
